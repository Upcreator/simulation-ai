PROXY_API_KEY=your_proxy_api_key_here
PROXY_BASE_URL=https://api.proxyapi.ru/openai/v1
DEFAULT_MODEL=gpt-4o

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Порог, после которого старые сообщения сжимаются в резюме
MAX_MESSAGES_BEFORE_SUMMARY=12
# Сколько последних сообщений оставлять "как есть" (не сжатыми)
KEEP_LAST_MESSAGES=6

DB_PATH=data/checkpoints.sqlite
